{
  "expo": {
    "name": "MedGuide",
    "slug": "medguide-mobile",
    "scheme": "medguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.medguide.app"
    },
    "ios": {
      "bundleIdentifier": "com.medguide.app"
    }
  }
}
